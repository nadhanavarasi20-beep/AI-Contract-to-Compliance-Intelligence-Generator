# Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Model Name: gemini-2.5-flash / gemini-2.0-flash / gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Built-in Rate Limiting (Prevents 429 Quota Exceeded errors)
MAX_REQUESTS_PER_MINUTE=10
REQUEST_DELAY_SECONDS=2.0

# Host and Port
HOST=127.0.0.1
PORT=8050
